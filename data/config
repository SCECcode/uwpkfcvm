# UTM Zone
utm_zone = 10

# Model directory
model_dir = uwpkfcvm
model_data_path  = https://g-c662a6.a78b8.36fe.data.globus.org/ucvm/models

# Number of cells in x, y, and z.
nx = 66
ny = 71
nz = 15 
## original data,
## x index from -65 to 65 without 0 (step = 2)
## y index from -70 to 70 with 0 cell (step = 2)
## z index from 0 to 28 (step = 2)
## one layer is 4686 points

# Depth, in meters
# NOTE: 0 km is ~ sea level and 28 km depth is 28 km below sea level.
depth = 28000
depth_interval = 2000

#center of the grid, 
#origin_lat = 35.960
#origin_lon = -120.505
rotation_anticlockwise = -40.0

